# Ignore invisible
.*
*~
!.gitignore
!.gitattributes
!.github/
!.cargo/
!.cargo/config.toml
!.gitleaks.toml
!.codespellrc
!.markdownlint.json
!.markdownlintignore
!.markdownlint-cli2.yaml

/target/
**/*.rs.bk
.DS_Store

# `neat-core` is a release-tag git dependency, so nothing checks NEAT-AI-core
# out here any more (Issue #210). A local clone dropped into the workspace for
# side-by-side work must still never be committed to this repo.
/NEAT-AI-core/
/NEAT-AI-core

# Ockham runtime outputs (do not commit experiment artefacts).
/runs/
/best.json
/experiments.jsonl
/winners/
/population-candidate.json
/population-candidate.meta.json
